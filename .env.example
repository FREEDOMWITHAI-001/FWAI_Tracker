# Copy to .env.local and fill in.

# ---------------------------------------------------------------------------
# Database (required) — one Postgres connection string, nothing else.
# ---------------------------------------------------------------------------
# Local development (docker compose up -d):
DATABASE_URL=postgres://fwai:fwai_local_dev@localhost:5433/fwai
#
# Managed/hosted example — point at the POOLED endpoint when deploying to
# Vercel, because each serverless invocation opens its own connection:
# DATABASE_URL=postgres://user:pass@host:6543/dbname?sslmode=require
#
# TLS is enabled automatically for any non-local host. Append
# ?sslmode=disable to force it off.

# Connections per server instance. Keep it small on serverless — the platform
# scales out by adding instances, so a big pool here multiplies fast.
# PGPOOL_MAX=3

# ---------------------------------------------------------------------------
# Secrets encryption (required if you use cloud accounts / Zoom / AI Sensy)
# ---------------------------------------------------------------------------
# Master key for AES-256-GCM at-rest encryption of provider credentials.
# Any long random string: openssl rand -base64 48
# CHANGING THIS MAKES EVERY ALREADY-STORED CREDENTIAL UNDECRYPTABLE.
APP_ENCRYPTION_KEY=your-long-random-string

# ---------------------------------------------------------------------------
# Scheduler (optional)
# ---------------------------------------------------------------------------
# CHECK_INTERVAL_MS=300000        # VM/app probes            (default 5 min)
# CLOUD_SYNC_INTERVAL_MS=300000   # cloud provider sync      (default 5 min)
# OPENAI_SYNC_INTERVAL_MS=3600000 # OpenAI credit sync       (default 1 hour)
# METRICS_RETENTION_DAYS=7        # vm_metrics/app_metrics pruning
# SCHEDULER_DISABLED=1            # turn the in-process scheduler off entirely
#
# NOTE the in-process scheduler above only works on a long-lived server (local
# dev, a VPS, Docker). On Vercel each invocation is short-lived and setInterval
# does not survive it, so the Vercel Cron below is the ONLY automation in
# production — see vercel.json.

# ---------------------------------------------------------------------------
# Cron authentication (REQUIRED in production)
# ---------------------------------------------------------------------------
# Shared secret for GET /api/cron/check-all. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" once the variable is set on the
# project. Generate one with: openssl rand -base64 36
#
# That route probes the whole fleet, sends WhatsApp messages and spends OpenAI
# quota, so it is NOT safe to leave open. With NODE_ENV=production and no secret
# set the route now refuses with 503 rather than running for anyone who calls it.
CRON_SECRET=another-long-random-string

# ---------------------------------------------------------------------------
# Dashboard access control (optional, but set it if the app is internet-facing)
# ---------------------------------------------------------------------------
# The app has no user accounts — it assumes a trusted internal Ops team. When
# BOTH of these are set, src/middleware.ts puts HTTP Basic Auth in front of every
# page and every /api route, so nothing can be read or written anonymously.
# Leave them unset for local development.
#
# Prefer your platform's own protection when you have it (on Vercel: Project ->
# Settings -> Deployment Protection -> Vercel Authentication). This is the
# portable fallback for any other host, and harmless as a second layer.
# DASHBOARD_USER=ops
# DASHBOARD_PASSWORD=a-long-random-passphrase
